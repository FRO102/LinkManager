# Copy this file to .env and adjust as needed, then load it before running
# `npm start` (e.g. with `node --env-file=.env server.js`, Node 20.6+, or any
# tool like `dotenv-cli`). Everything here is optional — the app runs fine
# with no .env file and the defaults shown below.
#
# If you're using Docker Compose instead, these same variables are already
# set (and documented) directly in docker-compose.yml — you don't need this
# file for that path.

# Port the server listens on.
PORT=3000

# Folder where links.db and backups/ are stored.
DATA_DIR=./data

# Number of daily backups to keep before rotating old ones out.
BACKUP_RETENTION=14

# How often (in hours) the automatic dead-link check runs in the background.
LINK_CHECK_INTERVAL_HOURS=24

# Max number of links accepted in a single import call (bookmarks or JSON).
IMPORT_MAX_ITEMS=5000

# If set, every /api request must send this value in the X-Auth-Token header.
# Leave unset (the default) for local or trusted-network use. /api/health
# always stays open regardless, so external healthchecks keep working.
# AUTH_TOKEN=
